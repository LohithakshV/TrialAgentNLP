{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": [
        "{.next,node_modules,public,docs,scripts,.venv,app}/**",
        "backend/tests/**",
        "**/__pycache__/**"
      ]
    }
  }
}
