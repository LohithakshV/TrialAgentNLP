{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/health.py": {
      "maxDuration": 60,
      "excludeFiles": "{.next,node_modules,public,docs,scripts,.venv,app,backend/tests}/**"
    },
    "api/extract.py": {
      "maxDuration": 60,
      "excludeFiles": "{.next,node_modules,public,docs,scripts,.venv,app,backend/tests}/**"
    },
    "api/search.py": {
      "maxDuration": "max",
      "excludeFiles": "{.next,node_modules,public,docs,scripts,.venv,app,backend/tests}/**"
    }
  }
}
